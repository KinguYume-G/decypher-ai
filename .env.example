# Application
DECYPHER_APP_ENV=development
DECYPHER_DEBUG=true
DECYPHER_SECRET_KEY=change-me-to-a-random-64-character-hex-value
DECYPHER_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL and Redis
DECYPHER_DATABASE_URL=postgresql+asyncpg://decypher:decypher@localhost:5432/decypher_db
DECYPHER_REDIS_URL=redis://localhost:6379/0

# AI provider: ollama | openai | deepseek
DECYPHER_AI_PROVIDER=ollama
DECYPHER_AI_MAX_TOKENS=4096

# Ollama. The client accepts the OpenAI-compatible /v1 base but calls the native
# /api/chat endpoint so structured responses can disable thinking output.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional source credentials. Never commit real values.
GITHUB_TOKEN=
STACKEXCHANGE_API_KEY=
PRODUCTHUNT_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DecypherAI/0.1.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Task defaults
DECYPHER_DEFAULT_TASK_INTERVAL=3600
DECYPHER_MAX_CONCURRENT_TASKS=5
DECYPHER_RATE_LIMIT_PER_MINUTE=60
