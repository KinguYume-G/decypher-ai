# ════════════════════════════════════════════════════════════════════
#  Decypher AI — 环境变量模板
#  复制此文件为 .env，填入真实值，永远不要把 .env 提交到 Git
# ════════════════════════════════════════════════════════════════════

# ── 应用基础 ────────────────────────────────────────────────────────
DECYPHER_APP_ENV=development
# 用 python -c "import secrets; print(secrets.token_hex(32))" 生成
DECYPHER_SECRET_KEY=change-me-to-a-random-64-char-hex-string
DECYPHER_DEBUG=true
DECYPHER_ALLOWED_ORIGINS=http://localhost:3000

# ── 数据库（Docker Compose 已配置，本地无需修改）──────────────────
DECYPHER_DATABASE_URL=postgresql+asyncpg://decypher:decypher@localhost:5432/decypher_db

# ── Redis（Docker Compose 已配置，本地无需修改）──────────────────
DECYPHER_REDIS_URL=redis://localhost:6379/0

# ════════════════════════════════════════════════════════════════════
#  AI 供应商（三选一，开发用 ollama，生产换 openai）
# ════════════════════════════════════════════════════════════════════

# ai provider: ollama | openai | deepseek
DECYPHER_AI_PROVIDER=ollama
DECYPHER_AI_MAX_TOKENS=4096

# ── Ollama（本地，完全免费）──────────────────────────────────────
# 安装：https://ollama.ai  然后运行：ollama pull qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:14b

# ── OpenAI（生产推荐，gpt-4o-mini 极便宜）────────────────────────
# 申请：https://platform.openai.com/api-keys
# 费用：gpt-4o-mini 约 $0.15/百万 tokens（每天分析 100 条机会 ≈ $0.01）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── DeepSeek（备用，比 OpenAI 便宜 10x）──────────────────────────
# 申请：https://platform.deepseek.com
# 费用：约 $0.014/百万 tokens
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ════════════════════════════════════════════════════════════════════
#  数据采集（按状态分组）
# ════════════════════════════════════════════════════════════════════

# ── ✅ 已有（直接可用）──────────────────────────────────────────────

# GitHub Token — 已配置，5000次/小时
# 申请（如需重新生成）：https://github.com/settings/tokens → Fine-grained → read:repo
GITHUB_TOKEN=

# ── ✅ 无需 Key（直接可用）─────────────────────────────────────────

# DEV.to（免费，无需 Key，10次/10秒）— Reddit 替代，开发者内容高质量
# 无需任何配置，自动生效

# arXiv（免费，无需 Key）— 学术论文，建议请求间隔 ≥ 3秒
# 无需任何配置，自动生效

# OpenAlex（免费，无需 Key）— 学术引用数据，10万次/天
# 无需任何配置，自动生效

# SEC EDGAR（免费，无需 Key）— 美股公开财报（仅研究用途，不构成投资建议）
# 无需任何配置，自动生效

# Stack Exchange（无 Key 时 300次/天，申请 Key 后 10000次/天）
# 无 Key 也可用，申请地址见下方
STACKEXCHANGE_API_KEY=

# ── 🟡 需要申请（全部免费，即时审批）──────────────────────────────

# Stack Exchange API Key — 从 300次/天 提升到 10000次/天
# 申请步骤（2分钟）：
#   1. 注册 https://stackapps.com/users/login
#   2. 进入 https://stackapps.com/apps/oauth/register
#   3. 填写 App Name: "Decypher AI"，OAuth Domain: localhost
#   4. 复制 Key 填入下方
# STACKEXCHANGE_API_KEY=已在上方，填入即可

# Product Hunt Developer Token — 商业/创业产品信号
# 申请步骤（5分钟）：
#   1. 登录 https://www.producthunt.com
#   2. 进入 https://api.producthunt.com/v2/docs → "Add Application"
#   3. 填写 App Name 和 Redirect URI（localhost 即可）
#   4. 复制 Developer Token 填入下方
PRODUCTHUNT_API_KEY=

# ── 🔵 可选（有 Key 后自动增强，无 Key 优雅降级返回 []）──────────

# Reddit OAuth2 — 如果后续能申请到（目前已被 DEV.to 替代）
# 申请：https://www.reddit.com/prefs/apps → Create App → script type
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DecypherAI/0.1.0

# ════════════════════════════════════════════════════════════════════
#  前端配置
# ════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Decypher AI
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── 任务与速率限制 ──────────────────────────────────────────────────
DECYPHER_DEFAULT_TASK_INTERVAL=3600
DECYPHER_MAX_CONCURRENT_TASKS=5
DECYPHER_RATE_LIMIT_PER_MINUTE=60

# ════════════════════════════════════════════════════════════════════
#  申请清单总结
#
#  现在就能用（无需任何操作）：
#    ✅ GitHub Token（已有）
#    ✅ HN Algolia, arXiv, OpenAlex, SEC EDGAR, DEV.to（无需 Key）
#    ✅ Ollama 本地 AI（已安装）
#
#  建议现在申请（免费，5分钟内完成）：
#    🟡 Stack Exchange Key → stackapps.com/apps/oauth/register
#    🟡 Product Hunt Token → api.producthunt.com/v2/docs
#
#  生产部署前申请（按量付费，极便宜）：
#    💰 OpenAI API Key → platform.openai.com/api-keys
#       或 DeepSeek API Key → platform.deepseek.com（更便宜）
# ════════════════════════════════════════════════════════════════════
